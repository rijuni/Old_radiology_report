# ============================================================
# .env — Environment variables for the Radiology Report backend
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file and rename it to:  .env
#   2. Fill in the real values below
#   3. NEVER commit the actual .env file to git (it's in .gitignore)
#   4. This template (.env.example) IS safe to commit
# ============================================================

# Django secret key — generate one using:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# Allowed hosts — comma-separated, no spaces
# Examples: localhost,127.0.0.1,192.168.1.50,radiology.kims.local
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL database credentials
DB_NAME=old_lab_report
DB_USER=report
DB_PASSWORD=Kims@123
DB_HOST=localhost
DB_PORT=3306

# Frontend origin(s) for CORS — comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Elasticsearch host
ELASTICSEARCH_HOST=http://localhost:9200
